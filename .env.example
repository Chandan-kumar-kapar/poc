# ============================================================
# Auth POC — environment template. Copy to .env and fill in.
# Secrets here are PLACEHOLDERS ONLY. Never commit real values.
# ============================================================

AUTH_MODE=BOTH                 # NORMAL | SSO | BOTH

# --- JWT (asymmetric default) ---
JWT_ALGORITHM=RS256
JWT_PRIVATE_KEY_PATH=/run/secrets/jwt_private.pem
JWT_PUBLIC_KEYS_PATH=/run/secrets/jwks/
JWT_ACTIVE_KID=poc-key-a
JWT_ISSUER=https://api.poc.local
JWT_AUDIENCE=poc-api
JWT_CLOCK_SKEW_SECONDS=60
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Argon2id ---
ARGON2_MEMORY_KIB=19456
ARGON2_TIME_COST=2
ARGON2_PARALLELISM=1

# --- SSO / OIDC ---
ENABLE_SSO=true
OIDC_CLIENT_ID=changeme
OIDC_CLIENT_SECRET=changeme
OIDC_AUTHORITY=https://login.microsoftonline.com/<tenant-id>/v2.0
OIDC_REDIRECT_URI=https://api.poc.local/auth/sso/callback
OIDC_SCOPES=openid profile email
OIDC_USE_PKCE=true
OIDC_REQUIRE_EMAIL_VERIFIED=true
OIDC_JWKS_CACHE_TTL_SECONDS=3600
AUTO_PROVISION_SSO_USERS=true
OIDC_DEFAULT_ROLE=User

# --- Infra ---
DATABASE_URL=postgresql+asyncpg://poc:poc@db:5432/poc
REDIS_URL=redis://redis:6379/0

# --- Seed accounts (demo only; override in real deployments) ---
SEED_ADMIN_EMAIL=admin@poc.local
SEED_ADMIN_PASSWORD=Admin!Passw0rd123
SEED_USER_EMAIL=user@poc.local
SEED_USER_PASSWORD=User!Passw0rd123

# --- CORS (comma-separated) ---
CORS_ORIGINS=http://localhost:3000
